# --- public host/IP of the machine running the stack (needed by coturn for relayed media)
PUBLIC_IP=203.0.113.10
# --- TURN (coturn). The server hands out time-limited credentials derived from TURN_SECRET.
TURN_REALM=kart.example.com
TURN_SECRET=change-me-to-a-long-random-string
# comma separated; use turns: (TLS) in production
TURN_URLS=turn:kart.example.com:3478?transport=udp,turn:kart.example.com:3478?transport=tcp
# optional custom STUN list
# STUN_URLS=stun:stun.l.google.com:19302
# --- dedicated rooms
DEDICATED_ROOMS=2
MIN_PLAYERS=2
AUTO_START_SEC=15
